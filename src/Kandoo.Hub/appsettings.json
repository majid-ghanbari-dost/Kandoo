{
  "ConnectionStrings": {
    "HubSqlite": "Data Source=kandoo-hub.db;Pooling=False"
  },
  "Hub": {
    "OwnerBootstrapProof": "",
    "LocalShutdownEnabled": false,
    "LogDirectory": "",
    "Backup": {
      "Enabled": false,
      "IntervalSeconds": 300,
      "RetentionFiles": 12,
      "DirectoryPath": "backups"
    },
    "Capture": {
      "Enabled": false,
      "SpoolDirectory": "C:\\Windows\\System32\\spool\\PRINTERS",
      "CaptureDirectory": "captures",
      "PollIntervalMilliseconds": 250,
      "StableScans": 2,
      "MaxCaptureBytes": 16777216
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
