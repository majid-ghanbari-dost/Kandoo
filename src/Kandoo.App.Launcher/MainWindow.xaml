<Window x:Class="Kandoo.App.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="کندو — راه‌اندازی اولیهٔ فروشگاه"
        Height="500"
        Width="520"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="کندو" FontSize="32" FontWeight="Bold" Foreground="#2B1D0E"
                       HorizontalAlignment="Center" />
            <TextBlock Text="راه‌اندازی اولیهٔ فروشگاه" FontSize="18" Foreground="#5a4a33"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Steps container -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Step 1: Store name -->
            <StackPanel x:Name="Step1Panel" Grid.Row="0">
                <TextBlock Text="۱. نام فروشگاه" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2B1D0E" Margin="0,0,0,12" />
                <TextBox x:Name="StoreNameEntry" Style="{StaticResource StoreNameBox}"
                         placeholder="نام فروشگاه را وارد کنید" />
                <Button x:Name="StartShopButton" Content="شروع راه‌اندازی خودکار"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnStartShopClicked" />
                <TextBlock x:Name="StatusLabel" Style="{StaticResource StatusText}"
                           Text="مرحله ۱: نام فروشگاه را وارد کنید." />
                <TextBlock x:Name="ErrorLabel" Foreground="#9A3B0A" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <Button x:Name="CopyReportButton" Content="کپی گزارش خطا"
                        Visibility="Collapsed"
                        Click="OnCopyReportClicked" />
            </StackPanel>

            <!-- Step 2: Auto-configuration -->
            <StackPanel x:Name="Step2Panel" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="۲. پیکربندی خودکار فروشگاه" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2B1D0E" Margin="0,0,0,12" />
                <ProgressBar x:Name="ConfigProgress" Height="24"
                             IsIndeterminate="True" Margin="0,0,0,16" />
                <TextBlock x:Name="Step2Status" Style="{StaticResource StatusText}"
                           Text="در حال راه‌اندازی خودکار فروشگاه…" />
            </StackPanel>

            <!-- Step 3: Finish -->
            <StackPanel x:Name="Step3Panel" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="۳. پایان راه‌اندازی" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2B1D0E" Margin="0,0,0,12" />
                <TextBlock Text="فروشگاه شما آماده است." FontSize="14"
                           Foreground="#256B43" Margin="0,0,0,16" />
                <Button x:Name="FinishButton" Content="ورود به برنامه"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnFinishClicked" />
                <TextBlock x:Name="Step3Status" Style="{StaticResource StatusText}"
                           Text="مرحله ۳: فروشگاه آماده است. وارد شدن به برنامه…" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="کندو — فاکتور دیجیتال"
                   FontSize="12" Foreground="#8a7a66" HorizontalAlignment="Center" />
    </Grid>
</Window>
