<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kandoo.App.CustomerInvoicesPage"
             Title="فاکتورهای من"
             Style="{StaticResource PageStyle}">
    <ScrollView>
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Style="{StaticResource RootStackStyle}">
                <Label Style="{StaticResource TitleStyle}" Text="فاکتورهای من" />
                <Label Style="{StaticResource BodyStyle}" Text="فاکتورهای صادره گروه‌بندی شده برحسب فروشگاه." />

                <Button x:Name="LoadButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="بارگذاری فاکتور‌ها"
                        Clicked="OnLoadClicked"
                        SemanticProperties.Description="بارگذاری فهرست فاکتورهای مشتری" />
                <Label x:Name="StatusLabel" Style="{StaticResource CaptionStyle}" />

                <VerticalStackLayout x:Name="InvoicesList" Style="{StaticResource RowStackStyle}" />

                <!-- Empty state -->
                <VerticalStackLayout x:Name="EmptyState"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="{StaticResource Space3}">
                    <Label Style="{StaticResource SectionTitleStyle}"
                           Text="هیچ فاکتور یافت نشد"
                           HorizontalTextAlignment="Center" />
                    <Label Style="{StaticResource BodyStyle}"
                           Text="فهرست فاکتورهای شما خالی است."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
