<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kandoo.App.SetupWizardPage"
             Title="راه‌اندازی اولیه"
             Style="{StaticResource PageStyle}">
    <ScrollView>
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Style="{StaticResource RootStackStyle}">
                <Label Style="{StaticResource TitleStyle}" Text="راه‌اندازی اولیه کندو" />
                <Label Style="{StaticResource BodyStyle}"
                       Text="در اولین اجرا، فروشگاه خود را تعریف کرده و برنامه را آماده کنید." />

                <!-- Step indicator -->
                <HorizontalStackLayout Style="{StaticResource ButtonRowStyle}">
                    <Label x:Name="Step1Label" Style="{StaticResource CaptionStyle}"
                           Text="۱. تعریف فروشگاه" />
                    <Label Style="{StaticResource CaptionStyle}" Text="—" />
                    <Label x:Name="Step2Label" Style="{StaticResource CaptionStyle}"
                           Text="۲. تنظیمات خودکار" />
                    <Label Style="{StaticResource CaptionStyle}" Text="—" />
                    <Label x:Name="Step3Label" Style="{StaticResource CaptionStyle}"
                           Text="۳. پایان و ورود" />
                </HorizontalStackLayout>

                <!-- Step 1: Store name -->
                <Border x:Name="Step1Panel" Style="{StaticResource RowStyle}">
                    <VerticalStackLayout Style="{StaticResource RowStackStyle}">
                        <Label Style="{StaticResource SectionTitleStyle}" Text="نام فروشگاه" />
                        <Entry x:Name="StoreNameEntry"
                               Style="{StaticResource InputStyle}"
                               Placeholder="نام فروشگاه را وارد کنید"
                               SemanticProperties.Description="نام فروشگاه برای داده‌های فروشگاه" />
                        <Button x:Name="StartShopButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="شروع راه‌اندازی خودکار"
                                Clicked="OnStartShopClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Step 2: Automatic configuration -->
                <Border x:Name="Step2Panel" Style="{StaticResource RowStyle}" IsVisible="False">
                    <VerticalStackLayout Style="{StaticResource RowStackStyle}">
                        <Label Style="{StaticResource SectionTitleStyle}" Text="تنظیمات خودکار فروشگاه" />
                        <Label Style="{StaticResource BodyStyle}"
                               Text="سرویس هاب محلی در حال اجرا است، ایجاد پایگاه داده و نشست مالک انجام می‌شود." />
                        <ActivityIndicator x:Name="SetupActivityIndicator"
                                           IsRunning="True"
                                           IsVisible="True"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Step 3: Finish -->
                <Border x:Name="Step3Panel" Style="{StaticResource RowStyle}" IsVisible="False">
                    <VerticalStackLayout Style="{StaticResource RowStackStyle}">
                        <Label Style="{StaticResource SectionTitleStyle}" Text="فروشگاه آماده است" />
                        <Label Style="{StaticResource BodyStyle}"
                               Text="تنظیمات ذخیره شده و برنامه آماده استفاده است." />
                        <Button x:Name="FinishButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Text="ورود به برنامه"
                                Clicked="OnFinishClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel" Style="{StaticResource BodyStyle}" />
                <Button x:Name="CopyReportButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="کپی گزارش خطا"
                        Clicked="OnCopyReportClicked"
                        IsVisible="False"
                        SemanticProperties.Description="کپی گزارش خطا در حافظه موقت" />
                <Label x:Name="CopyStatusLabel" Style="{StaticResource BodyStyle}" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
