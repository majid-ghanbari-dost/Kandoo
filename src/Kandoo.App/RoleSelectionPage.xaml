<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kandoo.App.RoleSelectionPage"
             Title="انتخاب نقش"
             Style="{StaticResource PageStyle}">
    <ScrollView>
        <Border Style="{StaticResource CardStyle}">
            <Grid RowDefinitions="48,40,72,64,56,56,56,80,56,56"
                  RowSpacing="{StaticResource Space4}"
                  Padding="{StaticResource PaddingSpace5}"
                  HorizontalOptions="Fill"
                  VerticalOptions="Start">
                <Label Grid.Row="0" Style="{StaticResource TitleStyle}" Text="به کندو خوش آمدید" />
                <Label Grid.Row="1" Style="{StaticResource SectionTitleStyle}" Text="نقش خود را انتخاب کنید" />
                <Label Grid.Row="2" x:Name="CurrentRoleLabel" Style="{StaticResource BodyStyle}" />
                <Label Grid.Row="3"
                       Style="{StaticResource DemoBannerStyle}"
                       Text="پروفایل محلی با داده نمونه؛ اطلاعات واقعی نیست" />
                <Button Grid.Row="4"
                        x:Name="StoreButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Text="فروشگاه"
                        Clicked="OnStoreClicked"
                        SemanticProperties.Description="انتخاب نقش فروشگاه: فاکتور، کالا و مشتری‌های فروشگاه خودم" />
                <Button Grid.Row="5"
                        x:Name="CustomerButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="مشتری"
                        Clicked="OnCustomerClicked"
                        SemanticProperties.Description="انتخاب نقش مشتری: فاکتورهای خریدم را یک‌جا ببینم" />
                <Button Grid.Row="6"
                        x:Name="BothButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="هر دو"
                        Clicked="OnBothClicked"
                        SemanticProperties.Description="انتخاب هر دو نقش: هم فروشگاه دارم، هم مشتری هستم" />
                <VerticalStackLayout Grid.Row="7" Spacing="{StaticResource Space1}">
                    <Label Style="{StaticResource CaptionStyle}"
                           Text="هر وقت بخواهید می‌توانید از بخش «نقش‌ها» عوض کنید." />
                    <Label x:Name="PlatformNoteLabel" Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
                <Button Grid.Row="8"
                        x:Name="BackButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="بازگشت"
                        IsVisible="False"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="بازگشت بدون تغییر نقش" />
                <Button Grid.Row="9"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Text="گزارش آخرین خطا"
                        Clicked="OnCrashReportClicked"
                        SemanticProperties.Description="نمایش و کپی آخرین گزارش خطای برنامه" />
            </Grid>
        </Border>
    </ScrollView>
</ContentPage>
