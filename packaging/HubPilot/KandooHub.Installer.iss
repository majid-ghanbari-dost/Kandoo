; Kandoo — Windows Installer (C-87)
; ======================================
; Build a self-contained setup.exe for the Kandoo Hub Windows host and
; the Kandoo Windows app. No .NET runtime is required on the target machine.
;\n; Build:\n;   1. Publish the self-contained Hub host:\n;        dotnet publish src/Kandoo.Hub/Kandoo.Hub.csproj `\n;           --configuration Release --runtime win-x64 --self-contained true `\n;           --output packaging\\HubPilot\\publish\\hub\n;   2. Publish the Windows MAUI app:\n;        dotnet publish src/Kandoo.App/Kandoo.App.csproj `\n;           --configuration Release --framework net8.0-windows10.0.19041.0 `\n;           --output packaging\\HubPilot\\publish\\app\n;   3. Compile this script:\n;        iscc packaging\\HubPilot\\KandooHub.Installer.iss\n;   Result: packaging\\HubPilot\\Output\\Kandoo-Setup-x64.exe\n;\n#define MyAppName \"Kandoo\"\n#define MyAppPublisher \"Kandoo\"\n#define MyAppURL \"https://kandoo.ir\"\n#define MyHubExeName \"Kandoo.Hub.exe\"\n#define MyAppExeName \"Kandoo.App.exe\"\n#define MyAppVersion \"1.1.0\"\n#define InstallerName \"Kandoo-Setup-x64\"\n\n[Setup]\n; Fixed AppId keeps upgrades replacing the same installation.\nAppId={4F1C2A3E-8B6D-4E1F-9C2D-7A3B5E1D9F40}\nAppName={#MyAppName}\nAppPublisher={#MyAppPublisher}\nAppPublisherURL={#MyAppURL}\nAppSupportURL={#MyAppURL}\nAppUpdatesURL={#MyAppURL}\nVersion={#MyAppVersion}\nDefaultDirName={pf}\\{#MyAppName}\nDefaultGroupName={#MyAppName}\nAllowNoIcons=yes\nLicenseFile=\nUninstallable=yes\nCompression=lzma\nSolidCompression=yes\nWizardStyle=modern\nPrivilegesRequired=admin\nArchitecturesInstallIn64BitMode=x64
OutputDir=.\Output\n\n[Languages]\nName: \"fa\"; MessagesFile: \"compiler:Languages\\Farsi.isl\"\nName: \"en\"; MessagesFile: \"compiler:Default.isl\"\n\n[Tasks]\nName: \"desktopicon\"; Description: \"{cm:CreateDesktopIcon}\"; GroupDescription: \"{cm:AdditionalIcons}\"; Flags: unchecked\n\n[Files]\n; Self-contained Hub publish output (built in step 1 above).\nSource: \"packaging\\HubPilot\\publish\\hub\\*\"; DestDir: \"{app}\"; Flags: ignoreversion recursesubdirs\n; Windows MAUI app publish output (built in step 2 above).\nSource: \"packaging\\HubPilot\\publish\\app\\*\"; DestDir: \"{app}\"; Flags: ignoreversion recursesubdirs\n; Launcher and configuration shipped with the installer.\nSource: \"packaging\\HubPilot\\Start-KandooHub.ps1\"; DestDir: \"{app}\"; Flags: ignoreversion\nSource: \"packaging\\HubPilot\\README.txt\"; DestDir: \"{app}\"; Flags: ignoreversion\n\n[Icons]\nName: \"{group}\\{#MyAppName}\"; Filename: \"{app}\\{#MyAppExeName}\"\nName: \"{group}\\{cm:UninstallProgram,{#MyAppName}}\"; Filename: \"{uninstallexe}\"\nName: \"{desktop}\\{#MyAppName}\"; Filename: \"{app}\\{#MyAppExeName}\"; Tasks: desktopicon\n\n[Run]\nFilename: \"{app}\\{#MyAppExeName}\"; \\\n    Description: \"{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}\"; \\\n    Flags: nowait postinstall skipifsilent unchecked\n\n[UninstallDelete]\nType: filesandordirs; Name: \"{app}\"
